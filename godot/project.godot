config_version=5

[application]

config/name="Crestview College"
run/main_scene="res://scenes/main/main_menu.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.1, 0.12, 1)